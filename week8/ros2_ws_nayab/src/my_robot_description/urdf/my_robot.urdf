<?xml version="1.0"?>
<robot name="my_mobile_robot">

  <!-- ================= MATERIALS ================= -->
  <material name="yellow">
    <color rgba="1.0 0.85 0.0 1.0"/>
  </material>
  <material name="dark_black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <!-- ================= BASE (rounded-corner approximation) ================= -->
  <link name="base_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.34 0.30 0.10"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.24 0.10"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <!-- Corner cylinder — front-left -->
    <visual>
      <origin xyz=" 0.17  0.12 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.10"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <!-- Corner cylinder — front-right -->
    <visual>
      <origin xyz=" 0.17 -0.12 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.10"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <!-- Corner cylinder — back-left -->
    <visual>
      <origin xyz="-0.17  0.12 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.10"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <!-- Corner cylinder — back-right -->
    <visual>
      <origin xyz="-0.17 -0.12 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.10"/>
      </geometry>
      <material name="yellow"/>
    </visual>

  </link>

  <!-- ================= CAMERA (centered on top of base, yellow) ================= -->
  <link name="camera">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.05"/>
      </geometry>
      <material name="yellow"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
  </joint>

  <!-- ================= LEFT WHEEL ================= -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="dark_black"/>
    </visual>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.05 0.15 -0.05" rpy="1.57 0 0"/>
  </joint>

  <!-- ================= RIGHT WHEEL ================= -->
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="dark_black"/>
    </visual>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.05 -0.15 -0.05" rpy="1.57 0 0"/>
  </joint>

  <!-- ================= CASTER WHEEL (FRONT) ================= -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="dark_black"/>
    </visual>
  </link>
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.15 0 -0.075" rpy="0 0 0"/>
  </joint>

</robot>
